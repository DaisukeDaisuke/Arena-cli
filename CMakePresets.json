{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-clang-release",
      "displayName": "Windows x64 Clang / Release (MSVC environment)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW GCC / Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++.exe",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "mingw-debug",
      "inherits": "mingw-release",
      "displayName": "MinGW GCC / Debug",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release", "jobs": 4 },
    { "name": "mingw-release", "configurePreset": "mingw-release", "jobs": 4 },
    { "name": "mingw-debug", "configurePreset": "mingw-debug", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release", "output": { "outputOnFailure": true } },
    { "name": "mingw-release", "configurePreset": "mingw-release", "output": { "outputOnFailure": true } },
    { "name": "mingw-debug", "configurePreset": "mingw-debug", "output": { "outputOnFailure": true } }
  ]
}
